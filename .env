# Checkout de Lemon Squeezy (live). No es un secreto.
# Para probar en test mode, crea .env.development.local (ignorado por git) con la URL de test.
VITE_LEMON_CHECKOUT_URL=https://orzixtech.lemonsqueezy.com/checkout/buy/437f8d29-59d8-4c51-824c-9ac844ac0b3d

# IDs de Lemon Squeezy que validan las licencias. No son secretos (la API los devuelve a quien activa una licencia).
# Mientras estén vacíos NO se puede activar ninguna licencia (falla cerrado): llénalos antes de publicar.
# Dónde verlos: Lemon Squeezy > Settings > Stores (store id) y Store > Products > cada producto/variante (ids).
# Las listas aceptan varios ids separados por coma.
VITE_LEMON_STORE_ID=486315
# Productos y variantes que dan PRO
VITE_LEMON_PRO_PRODUCT_IDS=1398750
VITE_LEMON_PRO_VARIANT_IDS=
# Productos y variantes que dan GOD
VITE_LEMON_GOD_PRODUCT_IDS=
VITE_LEMON_GOD_VARIANT_IDS=
# Qué variante es mensual, anual o vitalicia (opcional: si falta se deduce de la fecha de vencimiento)
VITE_LEMON_MONTHLY_VARIANT_IDS=
VITE_LEMON_ANNUAL_VARIANT_IDS=
VITE_LEMON_LIFETIME_VARIANT_IDS=
