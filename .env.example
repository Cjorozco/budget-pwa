VITE_LEMON_PRO_VARIANT_IDS=<variant-id>,<variant-id>
VITE_LEMON_GOD_PRODUCT_IDS=<product-id>
VITE_LEMON_GOD_VARIANT_IDS=<variant-id>
VITE_LEMON_MONTHLY_VARIANT_IDS=<variant-id>
VITE_LEMON_ANNUAL_VARIANT_IDS=<variant-id>
VITE_LEMON_LIFETIME_VARIANT_IDS=<variant-id>
