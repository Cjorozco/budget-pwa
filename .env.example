VITE_LEMON_CHECKOUT_URL=https://<store>.lemonsqueezy.com/checkout/buy/<variant-uuid>

# IDs de Lemon Squeezy que validan las licencias (no son secretos). Vacíos = no se puede activar nada.
# Un solo plan pago: el aporte único que desbloquea PRO.
VITE_LEMON_STORE_ID=<store-id>
VITE_LEMON_PRO_PRODUCT_IDS=<product-id>
VITE_LEMON_PRO_VARIANT_IDS=<variant-id>,<variant-id>
